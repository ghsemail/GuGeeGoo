# 复制为仓库根 .env 或 infra/cos/.env（均在 .gitignore 内）
# 腾讯云 API 密钥：https://console.cloud.tencent.com/cam/capi

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 例：gugeegoo-1234567890
COS_BUCKET=
# 例：ap-shanghai
COS_REGION=

# 前端公开资源根（不含末尾斜杠），配置 Pages 环境变量 VITE_COS_PUBLIC_BASE_URL
# COS_PUBLIC_BASE_URL=https://your-bucket.cos.ap-shanghai.myqcloud.com
