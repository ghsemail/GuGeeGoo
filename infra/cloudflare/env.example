# 复制为仓库根 `.env`（已在 .gitignore 内），供本地 `npm run deploy:pages` 使用。
# GitHub Actions 请改用 Secrets / Variables（见 infra/cloudflare/pages.md）。

# Cloudflare API Token（需 Account → Cloudflare Pages: Edit；后续 Worker 需 Workers Scripts: Edit）
CLOUDFLARE_API_TOKEN=

# 可与 wrangler.toml 中 account_id 相同；本地可省略（脚本会读 wrangler.toml）
CLOUDFLARE_ACCOUNT_ID=15b1233497d3363a2240f8a54f900fe2

# 构建时注入 Vite（公开 PDF 的 CDN 根 URL，不含末尾斜杠）
# GitHub 可在 Repository → Settings → Variables 配置同名变量
VITE_COS_PUBLIC_BASE_URL=
